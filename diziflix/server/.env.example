# diziflix server configuration — copy to .env and adjust.

# HTTP bind
HOST=0.0.0.0
PORT=8090

# Catalogue source adapter: the module name under app/sources/ (mock = bundled fixture)
SOURCE=mock

# Paths (relative paths are resolved against the server/ directory)
FIXTURE_PATH=data/fixture.json
# DATA_DIR is the base of everything the server writes (db, imgcache, ops_settings.json, TMDB previews,
# scraper_state); DB_PATH / IMG_CACHE_DIR default to paths inside it and can be overridden one by one.
# DATA_DIR=data
DB_PATH=data/diziflix.db
IMG_CACHE_DIR=data/imgcache

# Seconds between background catalogue refreshes (0 disables the scheduler)
CACHE_TTL=900

# While a scan runs the catalogue the TV sees is rebuilt at its stages (titles written, each series' episode
# inventory, TMDB seasons), not only when the scan ends. Minimum seconds between two such mid-scan refreshes
# (0 = no debounce; only one refresh runs at a time either way). The refresh after the scan always happens.
INGEST_REFRESH_MIN_INTERVAL=20

# Artwork rendering
IMG_QUALITY=82
IMG_MAX_AGE=86400

# Max items returned in an eagerly loaded /api/boot row
ROW_LIMIT=20

# tv-v1 home (app/homelayout.py): rows top to bottom (comma-separated row ids; an empty row is left out), slider size per
# type, only-playable titles on the home, and the "Dikkate Değer Filmler" classics thresholds (rating >= / released >= N years ago)
# HOME_LAYOUT=continue,trending_series,series,trending_movies,noteworthy_movies,movies,mylist
# HERO_SERIES=3
# HERO_MOVIES=3
# HOME_ONLY_READY=1
# CLASSIC_MIN_RATING=7.5
# CLASSIC_MIN_AGE_YEARS=15

# --- Canonical film library (SOURCE=library) ---
# DEFAULTS only: auto scan is managed in the admin panel (/admin -> Ayarlar, saved to
# data/ops_settings.json, no restart) and a saved value wins over these.
# Sources ingested on a schedule by default (comma-separated scraper site ids).
# Empty = none (run tools/ingest.py manually or enable in the admin panel).
INGEST_SITES=
# Default seconds between scheduled ingests (default 6h; 0 = off). Be gentle to upstream sites.
INGEST_INTERVAL=21600

# Isolated scraper runtime (tools/install_crawler.sh on Linux).
# Crawlee handles plain HTTP; Obscura handles every browser-mode page.
# Omit these paths to use the automatic Linux defaults.
# SCRAPER_WORKER_PYTHON=/opt/diziflix-crawler/venv/bin/python
# SCRAPER_WORKER_USER=diziflix-crawler
# SCRAPER_OBSCURA_BINARY=/opt/diziflix-obscura/obscura
# Hosts the /img proxy may fetch real posters from (SSRF guard, suffix match).
REMOTE_IMG_HOSTS=sinemalar.com,cdn.sinemalar.com,yabancidizi.news,image.tmdb.org

# --- TMDB enrichment/matching (optional; leave blank to skip gracefully) ---
# Movie poster/backdrop (and missing metadata) come from TMDB; the scraped source
# image stays as fallback. TMDB_ACCESS_KEY may be a v4 read-access token (eyJ...,
# sent as Bearer) or a v3 api key (sent as api_key=); the type is auto-detected.
# TMDB_TOKEN / TMDB_API_KEY are still accepted. Never commit/log the value.
TMDB_ACCESS_KEY=
TMDB_TOKEN=
TMDB_API_KEY=
# DEFAULT types to enrich: movie | movie,series. The admin Ayarlar > TMDB card overrides it once saved
# (also the "auto enrich new items" switch lives there, not here).
TMDB_ENRICH_TYPES=movie
# Days before an unmatched/low-confidence title is looked up again
TMDB_RETRY_DAYS=7
# TMDB image sizes: poster w500|w780 (also season posters), backdrop w1280,
# episode stills w92|w185|w300|original (original ~270 KB raw per still; w300 saves disk)
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=w1280
TMDB_STILL_SIZE=original
# 1 = also prewarm episode stills after every catalogue refresh (default 0: downloaded on the first /img request)
IMG_PREWARM_STILLS=0
# Request timeout (s), parallel lookups, and total seconds one ingest may spend on TMDB
TMDB_TIMEOUT=6
TMDB_CONCURRENCY=4
TMDB_BUDGET_SECONDS=90
# Match thresholds: auto-match needs score >= AUTO_SCORE, title similarity >= MIN_SIM (the year
# bonus cannot rescue a weak title) and a lead of MARGIN over the runner-up; a source without a
# year needs similarity >= MIN_SIM_NOYEAR; scores below REVIEW_SCORE are unmatched.
TMDB_AUTO_SCORE=0.85
TMDB_MIN_SIM=0.9
TMDB_MARGIN=0.08
TMDB_MIN_SIM_NOYEAR=0.97
TMDB_REVIEW_SCORE=0.55
# Alternative/translated-title requests per title when the hit's titles are not similar enough (0 = off)
TMDB_ALT_TITLE_LOOKUPS=3
# Backfill existing library: python -m tools.tmdb_enrich [--type movie|series] [--limit N] [--dry-run] [--force] [--verbose]
# Season posters + episode data/stills of matched series: python -m tools.tmdb_enrich --seasons [--limit N] [--dry-run] [--force]

# --- Self-healing scraper ---
# Master switch for LLM selector self-heal on drift (default off = deterministic only).
SCRAPER_HEAL_ENABLED=false
# Heal backend: codex_cli (subscription codex CLI) | pi (pi CLI one-shot) | pi_agent (the onboarding skill in repair mode: the
# agent inspects pages, tests yaml / provider recipes in the sandbox; drift AND playback heals) | openai_compatible (future).
SCRAPER_HEAL_PROVIDER=codex_cli
# Seconds to wait for the LLM to answer before giving up gracefully.
SCRAPER_HEAL_TIMEOUT=120
# If true, a sandbox-validated healed config is versioned AND activated automatically.
# Default only; the admin panel (Ayarlar) overrides it once saved.
SCRAPER_HEAL_AUTOAPPLY=false
# For SCRAPER_HEAL_PROVIDER=pi (subscription-authed via ~/.pi/agent/auth.json, no API key).
# One-shot spawn per heal (no warm daemon). Model + optional binary path override:
# SCRAPER_HEAL_MODEL=openai-codex/gpt-5.6-terra
# SCRAPER_HEAL_PI_BIN=pi
# For SCRAPER_HEAL_PROVIDER=pi_agent: longest one repair-agent run (s, default 300) and longest server-side verification of its proposal (s, default 420).
# SCRAPER_HEAL_AGENT_TIMEOUT=300
# SCRAPER_HEAL_VERIFY_TIMEOUT=420
# Only for SCRAPER_HEAL_PROVIDER=openai_compatible (future use):
# SCRAPER_HEAL_BASE_URL=
# SCRAPER_HEAL_API_KEY=

# --- Series inventory crawl (all seasons/episodes of every series; see README "Series inventory crawl") ---
# Series per ingest run (0 turns the stage off; what is not reached waits for the next run) and its time budget (s).
SERIES_CRAWL_BUDGET=15
SERIES_CRAWL_SECONDS=300
# Seconds between two requests of the stage (be gentle: one request at a time already).
SERIES_CRAWL_DELAY=3
# Re-read a complete inventory at least every N days (0 = only when a newer episode shows up) / hours before an
# unfinished or failed series is asked again (doubles per consecutive failure, max x16).
SERIES_CRAWL_REFRESH_DAYS=7
SERIES_CRAWL_RETRY_HOURS=6
# Pages per series (series page + season pages it did not list) / consecutive failures that stop the pass.
SERIES_CRAWL_MAX_PAGES=6
SERIES_CRAWL_MAX_ERRORS=5

# --- Content that is not public (yaml `blocked:` rules / `availability_gate:`; a site without them is not affected) ---
# A page / series found blocked ("telif engeli": no player) is judged again after this many days (0 = every scan).
BLOCKED_RECHECK_DAYS=7
# Pages one scan may probe BEFORE writing films / card-only series (the gate); old blocked episode/film pages re-judged per scan.
GATE_BUDGET=40
GATE_RECHECK_PAGES=3

# --- Playback resolution (viewer waiting on a black screen; the polite crawl transport is NOT affected) ---
# Per HTTP request: timeout (s), tries (network/429/5xx only; 0.3 s then 0.8 s backoff), courtesy delay per host (0 = none).
RESOLVE_TIMEOUT=6
RESOLVE_RETRIES=2
RESOLVE_MIN_DELAY=0
# Candidates of ONE source resolved at once (2x vidmoly + moly + OK.ru = 4) / sources of one episode/film resolved at once.
RESOLVE_PARALLEL=4
RESOLVE_SOURCES_PARALLEL=3
# Wall clock limits (s): per candidate / whole source; once one candidate has streams, the others get RESOLVE_GRACE more seconds.
RESOLVE_CANDIDATE_TIMEOUT=12
RESOLVE_TOTAL_TIMEOUT=20
RESOLVE_GRACE=3
# Time budget (s) of ONE browser-carried candidate (player_page `fetch: browser`, a browser session takes 10+ s): only that
# candidate (and the whole-source limit, +2 s) gets longer than the two limits above; a quick candidate with streams still cuts it off after the grace.
RESOLVE_BROWSER_TIMEOUT=40
# 1 = candidates that answered clearly faster (0.5 s buckets) come first, 0 = keep the page's order.
RESOLVE_FAST_FIRST=1
# Seconds a resolved payload is reused (stream URLs can be bound to the server IP: keep it short) / seconds a failed
# candidate or source is not asked again.
RESOLVE_CACHE_TTL=900
RESOLVE_NEG_TTL=60
# A payload whose stream URLs carry their own expiry (OK.ru `expires`, googlevideo `expire`, signed CDN X-Amz-* ...) is reused
# until that moment minus RESOLVE_CACHE_MARGIN (s), at most RESOLVE_CACHE_MAX_TTL (s, never below RESOLVE_CACHE_TTL; URLs
# without a hint keep RESOLVE_CACHE_TTL). A reused payload that runs out within RESOLVE_REFRESH_AHEAD (s) is answered from
# the cache and resolved again in the background (the next playback is fresh). A playback error drops the source's payload.
RESOLVE_CACHE_MAX_TTL=21600
RESOLVE_CACHE_MARGIN=300
RESOLVE_REFRESH_AHEAD=600
# 1 = resolve the most likely source in the background when a detail page opens (default off).
RESOLVE_PREFETCH=0

# --- Stream proxy (GET|HEAD /api/stream-proxy/<token>: OK.ru's signed mp4 URLs only work with the resolver's User-Agent) ---
# HMAC key of the proxy tokens (empty = generated once and kept in DATA_DIR/stream_proxy.key, 0600; never logged) / seconds a
# token (= a /api/streams answer) stays valid / simultaneous proxied connections (503 above that).
# STREAM_PROXY_SECRET=
# STREAM_PROXY_TTL=21600
# STREAM_PROXY_MAX=8
# Base of the proxy URLs in /api/streams. Empty = the address the client used (X-Forwarded-Proto/-Host or Forwarded behind a
# tunnel, else Host + scheme), so a LAN client stays on the LAN. Set (https://host[:port][/prefix]) only to force one base.
# STREAM_PROXY_BASE_URL=
# What else is proxied (/api/streams `proxy_reason`): STREAM_PROXY_FORCE=1 proxies EVERY mp4 / hls stream (all bandwidth goes
# through the server); STREAM_PROXY_HOSTS = comma separated hosts (a name also covers its subdomains) that are always proxied.
# Default: only streams bound to the User-Agent (ua), to the server's IP (googlevideo ip=, ip), a recipe with `stream_proxy: true`
# (recipe) or a source the server learned to need it (learned, see STREAM_DIAG).
# STREAM_PROXY_FORCE=0
# STREAM_PROXY_HOSTS=
# HLS proxy: upstream connections at a time PER STREAM (a player asks for many segments at once; a full group queues the request up
# to STREAM_PROXY_QUEUE_WAIT seconds, then 503) / longest playlist read (bytes) / most URIs one playlist may hold.
# STREAM_PROXY_HLS_MAX=24
# STREAM_PROXY_QUEUE_WAIT=8
# STREAM_PROXY_PLAYLIST_MAX=2097152
# STREAM_PROXY_PLAYLIST_URIS=20000
# Playback failure diagnosis: after a failed /api/playback-report the server probes the source's streams in the background
# (once per source per COOLDOWN seconds, PARALLEL probes at a time, TIMEOUT seconds per request) and stores the verdict in
# video_sources.last_diag (admin Kütüphane). A stream refused without its headers / bound to an ip= that the server can read is
# LEARNED (proxy_required): it is proxied from then on. STREAM_DIAG=0 switches it off.
# STREAM_DIAG=1
# STREAM_DIAG_COOLDOWN=600
# STREAM_DIAG_PARALLEL=2
# STREAM_DIAG_TIMEOUT=8

# --- Trailer liveness check (YouTube oEmbed when a detail page opens; dead trailer -> button hidden) ---
# 0 = off. Timeout per oEmbed request (s) / longest a detail or streams response waits for it (s; the check finishes
# in the background and is cached) / how long a verdict is reused (s): alive 24 h, dead 6 h. Timeouts are never cached.
TRAILER_CHECK=1
TRAILER_CHECK_TIMEOUT=3
TRAILER_CHECK_BUDGET=2.5
TRAILER_OK_TTL=86400
TRAILER_DEAD_TTL=21600

# --- Site onboarding sandbox (localhost-only tool endpoints of the pi agent; /api/onboard/sandbox/*) ---
# Longest one sandbox call may take (s; 504 after that) / size cap of one stored page (bytes) / days after which stored
# pages and drafts (saved ones excepted) are deleted.
# ONBOARD_TOOL_TIMEOUT=120
# ONBOARD_MAX_PAGE_BYTES=3000000
# ONBOARD_RETENTION_DAYS=7

# --- Site onboarding job (admin "Site ekle": a pi agent session writes a draft site yaml; needs pi + the heal LLM account) ---
# 0 = feature off / longest one pi run (s) / pi binary (default SCRAPER_HEAL_PI_BIN, then "pi") / model (default SCRAPER_HEAL_MODEL).
# ONBOARD_ENABLED=1
# ONBOARD_TIMEOUT=900
# ONBOARD_PI_BIN=pi
# ONBOARD_MODEL=
# Automatic correction rounds: a draft that fails its acceptance criteria goes back to the SAME agent session up to this many times
# (failing criteria + hints + diagnostics) before the admin sees it. 0 = off, at most 5. (An edit of a registered site is never retried.)
# ONBOARD_AUTO_ROUNDS=2
# ONBOARD_HARDEN=1   # 0 = switch off the hardening criteria of a new site's onboarding (availability_gate_defined, series_signal_collection, ...)

# --- Playback-triggered heal (scraper/playheal.py): sources of one site keep failing the same way -> a repair run ---
# Needs SCRAPER_HEAL_ENABLED=true and a healthy LLM account; applying the result follows the admin "heal_autoapply" setting.
# 0 = off / different sources the sliding window keeps / min. different FAILED sources / min. share of failed sources.
# PLAYHEAL_ENABLED=1
# PLAYHEAL_WINDOW=12
# PLAYHEAL_MIN_SOURCES=3
# PLAYHEAL_FAIL_RATIO=0.6
# A scan whose series items mostly have NO episode source: share of such series (0.1 .. 1) / least number of series that count as a signal.
# PLAYHEAL_COVERAGE_RATIO=0.5
# PLAYHEAL_COVERAGE_MIN_SERIES=5

# --- Multi-site live search (GET /api/search fans out to every site with a search endpoint; library/search_all.py) ---
# Sites searched at once / seconds one site may take / seconds the whole fan-out may take /
# consecutive failures that park a site / seconds a parked site is skipped.
# SEARCH_PARALLEL=4
# SEARCH_SITE_TIMEOUT=8
# SEARCH_TOTAL_TIMEOUT=12
# SEARCH_BREAKER_FAILS=3
# SEARCH_BREAKER_COOLDOWN=300

# --- Source finder (library/sourcefinder.py): a play request without a playable stream starts a background search ---
# Re-resolve the known sources -> search the title on other sites -> repair agent (needs SCRAPER_HEAL_ENABLED + a healthy LLM
# account); a found source is a notification (GET /api/notifications). 0 = off / seconds before the same title+episode may
# start another job / jobs at once / other sites searched per job / repair-agent runs per 24 h.
# SOURCEFINDER_ENABLED=1
# SOURCEFINDER_COOLDOWN=3600
# SOURCEFINDER_MAX_JOBS=2
# SOURCEFINDER_MAX_SITES=4
# SOURCEFINDER_DAILY_BUDGET=10
