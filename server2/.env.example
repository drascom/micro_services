# diziflix server2 — the only environment variables (README §6). Everything else lives in the `settings` table (admin).
HOST=0.0.0.0
PORT=8091
# All runtime data (diziflix2.db, imgcache/, pages/, providers/) lives here; relative paths are relative to server2/.
DATA_DIR=data
# TMDB v4 bearer token or v3 key. Never logged, never returned, never put into an LLM prompt.
TMDB_ACCESS_KEY=
# pi CLI binary used by the one-shot LLM caller (T06) and its model.
PI_BIN=pi
# boş = pi'nin kendi varsayılan modeli (pi settings)
LLM_MODEL=
# HMAC secret for signed stream-proxy tokens (T03); empty = generated per process.
STREAM_PROXY_SECRET=
# Obscura browser binary for fetch mode=browser (T01); empty = browser mode unavailable.
OBSCURA_BIN=
