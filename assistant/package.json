{
  "name": "personal-assistant",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts serve",
    "doctor": "node src/main.ts doctor",
    "login": "node src/main.ts login",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build-app": "node scripts/build-app.ts",
    "rebuild-app": "node scripts/build-app.ts --replace",
    "test:native": "node scripts/test-native.ts",
    "sign-app": "node scripts/sign-app.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "pi-web-access": "0.41.0",
    "proper-lockfile": "^4.1.2",
    "typebox": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0"
  }
}
