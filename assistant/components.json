      "source": {
        "type": "github",
        "repo": "ggml-org/llama.cpp",
        "asset": "llama-{version}-bin-macos-arm64.tar.gz"
      },
      "channel": "prerelease",
      "platform": "darwin-arm64",
      "path": "runtime/llama",
      "installed": {
        "json": "runtime/llama/BUILD.json",
        "key": "version"
      },
      "install": {
        "script": "scripts/install-llama.sh"
      },
      "smoke": {
        "cmd": [
          "{dir}/llama-server",
          "--version"
        ],
        "expect": "version: \\d+"
      },
      "perf": "llama",
      "restart": "llama",
      "uses": "llama-server -m --alias -ngl 999 -c --flash-attn on --cache-type-k/v q8_0 --reasoning-budget --reasoning-budget-message --parallel 1 --jinja --poll 0 --api-key; embeddings server (--embeddings --pooling, mmproj); OpenAI /v1/chat/completions tool calls, /health, /embedding"
    },
