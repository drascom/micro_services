<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://diziflix.local/DiziFlix"
        version="2.2.1"
        viewmodes="maximized">
  <tizen:application id="dzfLX00001.DiziFlix"
                     package="dzfLX00001"
                     required_version="2.4"/>
  <tizen:profile name="tv"/>
  <name>DIZIFLIX</name>
  <description>DIZIFLIX web istemcisi (Tizen paketi)</description>
  <author email="dev@diziflix.local">diziflix</author>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <!-- CSP: tanimsizsa Tizen varsayilani (default-src *) blob:'u kapsamaz -> hls.js MSE blob: URL'si
       "Media load rejected by URL safety check" (code 4) ile reddedilir. media-src/worker-src blob: acik. -->
  <tizen:content-security-policy>default-src * 'self' data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * 'self' blob: 'unsafe-inline' 'unsafe-eval'; style-src * 'self' 'unsafe-inline'; img-src * 'self' data: blob:; media-src * 'self' data: blob: mediastream:; worker-src * 'self' blob:; child-src * 'self' blob:; connect-src * 'self' data: blob:; font-src * 'self' data:; object-src *</tizen:content-security-policy>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
