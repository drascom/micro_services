# deploy.sh / clear-remote.sh sunucu ayarı. Kopyalayın: cp deploy.env.example deploy.env (deploy.env git dışıdır).
# Ortam değişkenleri (DZ_HOST=... ./deploy.sh) bu dosyadaki değerleri ezer.
DZ_HOST="drascom@192.168.0.124"          # ssh hedefi (anahtarla, parolasız; root değilse NOPASSWD sudo)
DZ_DEST="/home/drascom/diziflix/server"  # sunucudaki server/ dizini ('server' ile bitmeli)
DZ_SERVICE="diziflix"                    # systemd servis adı
DZ_PORT="8090"                           # uvicorn portu (uç doğrulaması)
DZ_BACKUP_DIR="/home/drascom/diziflix-backups"  # deploy yedeklerinin dizini (varsayılan /root)
