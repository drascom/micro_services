# Bind only the two intended interfaces. Comma-separated explicit addresses are supported.
INET_VIEWER_LISTEN=192.168.0.96:8080,100.111.37.77:8080
# Wildcard addresses are rejected unless this is exactly "true".
INET_VIEWER_ALLOW_WILDCARD=false
DATABASE_URL=sqlite:///var/lib/inet-viewer/inet-viewer.sqlite
INET_VIEWER_STATIC_DIR=/usr/local/lib/inet-viewer/web
# Optional active LAN discovery. Only private IPv4 CIDRs from /24 through /32 are accepted.
INET_VIEWER_LAN_CIDR=192.168.0.0/24
RUST_LOG=inet_viewer_server=info,tower_http=info
