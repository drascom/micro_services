<?xml version="1.0" encoding="utf-8"?>
<!-- DiziFlix uygulama ikonu: ön plan = yazısız karakter (bilet + klaket + şerit; 108 dp tuvalde ortadaki ~%60, güvenli bölge içinde),
     zemin = sıcak koyu kahve + yumuşak ışık (Tizen icon.png zemini). monochrome = Android 13+ tema ikonu. Kaynak: docs/brand/make_brand.py -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
