# Environment Variables for LivAuto
# Hair Transplant Pre-Op Questionnaire Processing

# ===========================================
# Email (IMAP) Configuration
# ===========================================
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=automation@example.com
IMAP_PASSWORD=demo-imap-password
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true

# ===========================================
# PDF Extraction Method
# ===========================================
# Options: pymupdf (fastest), pdfplumber (best for forms), docling (remote)
PDF_EXTRACTION_METHOD=pymupdf

# Docling (only needed if PDF_EXTRACTION_METHOD=docling)
DOCLING_URL=http://127.0.0.1:5001/v1/convert/file
DOCLING_TIMEOUT=120

# ===========================================
# LLM Configuration
# ===========================================
# Provider: "openai" or "anthropic" or "ollama"
LLM_PROVIDER=ollama

# Ollama (self-hosted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1:8b

# OpenAI (if using)
# OPENAI_API_KEY=sk-demo-openai-key
# OPENAI_MODEL=gpt-4o

# Anthropic (if using)
# ANTHROPIC_API_KEY=sk-ant-demo-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM Parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ===========================================
# Google API (for Sheets, Slides, etc.)
# ===========================================
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ===========================================
# Basic Authentication
# ===========================================
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme123
